<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Net.Web.Api.Sdk.Web.Examples</RootNamespace>
    <AssemblyName>Net.Web.Api.Sdk.Web.Examples</AssemblyName>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>doc-api-sdk-example.xml</DocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <Title>.NET Web API SDK Examples</Title>
    <Description>Example host showing how to consume the .NET Web API SDK on ASP.NET Core.</Description>
    <Company>Net.Web.Api.Sdk</Company>
    <Copyright>Copyright © Net.Web.Api.Sdk</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Net.Web.Api.Sdk\Net.Web.Api.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SwaggerConfiguration.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="token-example.config" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="App_Data\Certficates\net-web-api-jwt-signing.pfx" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="App_Data\Certficates\net-web-api-jwt-validating.cer" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
