<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Net.Web.Api.Sdk.Web.Examples</RootNamespace>
    <AssemblyName>Net.Web.Api.Sdk.Web.Examples</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>doc-api-sdk-example.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Net.Web.Api.Sdk\Net.Web.Api.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SwaggerConfiguration.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Update="token-example.config" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Certificates\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
