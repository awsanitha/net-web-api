<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Net.Web.Api.Sdk.Web.Examples</RootNamespace>
    <AssemblyName>Net.Web.Api.Sdk.Web.Examples</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Net.Web.Api.Sdk\Net.Web.Api.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SwaggerConfiguration.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\Certficates\net-web-api-jwt-signing.pfx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="App_Data\Certficates\net-web-api-jwt-validating.cer" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="token-example.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
