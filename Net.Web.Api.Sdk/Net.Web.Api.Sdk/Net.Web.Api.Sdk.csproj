<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Net.Web.Api.Sdk</RootNamespace>
    <AssemblyName>Net.Web.Api.Sdk</AssemblyName>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>Documentation\Swagger\Resources\doc-api-sdk.xml</DocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Title>.NET Web API SDK</Title>
    <AssemblyTitle>Development kit for WEP API</AssemblyTitle>
    <Description>Development kit for WEP API</Description>
    <Company>Rascalon Robert</Company>
    <Copyright>Copyright © 2019</Copyright>
    <ComVisible>false</ComVisible>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
    <PackageReference Include="ByteSize" Version="2.1.2" />
    <PackageReference Include="Castle.Core" Version="5.2.1" />
    <PackageReference Include="Castle.Windsor" Version="6.0.0" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.14" />
    <PackageReference Include="Microsoft.Web.Xdt" Version="3.2.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NuGet.Packaging" Version="6.14.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="9.0.6" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Documentation\Swagger\Resources\SwaggerConfigurationSdk.json" />
    <EmbeddedResource Include="Documentation\Swagger\Resources\index.html" />
    <EmbeddedResource Include="Documentation\Swagger\Resources\logo-16x16.png" />
    <EmbeddedResource Include="Documentation\Swagger\Resources\logo-32x32.png" />
    <EmbeddedResource Include="Documentation\Swagger\Resources\swagger-ui-override.css" />
    <EmbeddedResource Include="Documentation\Swagger\Resources\swagger-ui-override.js" />
    <EmbeddedResource Include="Documentation\Swagger\Resources\swagger.html" />
    <EmbeddedResource Include="Documentation\Swagger\Resources\doc-api-sdk.xml" />
    <EmbeddedResource Include="Security\Resources\token-sdk.config" />
    <EmbeddedResource Include="packages.info.config" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Net.Web.Api.Sdk.nuspec" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
